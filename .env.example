# Local development defaults only. Never commit .env or real credentials.
# Set NODE_ENV=production on the API host; configure its secrets in the host's secret store.
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=textbook_app
DB_PASSWORD=replace-with-your-local-db-password
DB_NAME=textbook_adoption_dev
# Use verified TLS for a remote/managed database. Optional CA path is server-only.
DB_SSL=false
# DB_SSL_CA_FILE=/absolute/path/to/provider-ca.pem
# Generate a private random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=5009
# API_HOST defaults to 127.0.0.1 locally, 0.0.0.0 in production. Override only if needed.
# API_HOST=127.0.0.1
# Optional exact proxy IPs/CIDRs, comma-separated; leave unset until host topology is known.
# TRUST_PROXY=127.0.0.1/32
# Production requires one exact HTTPS browser origin, with no trailing slash/path.
FRONTEND_ORIGIN=http://localhost:3000
# Only this public frontend value is needed. Set its HTTPS production origin at BUILD time.
REACT_APP_API_BASE_URL=http://localhost:5009
